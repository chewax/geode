{
  "name": "geode",
  "version": "0.8.1",
  "description": "Notas versionadas sobre Git — local-first, extensible.",
  "author": "Daniel Waksman <dwaksman@gmail.com>",
  "license": "MPL-2.0",
  "homepage": "https://github.com/chewax/geode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chewax/geode.git"
  },
  "bugs": {
    "url": "https://github.com/chewax/geode/issues"
  },
  "private": true,
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "build:iframe": "vite build --config vite.iframe.config.ts",
    "dev": "npm run build:iframe && electron-vite dev",
    "build": "npm run typecheck && npm run build:iframe && electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.4",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "diff3": "0.0.3",
    "dompurify": "^3.4.11",
    "isomorphic-git": "^1.38.6",
    "lucide-react": "^1.23.0",
    "marked": "^18.0.5",
    "mermaid": "^12.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.12"
  }
}
